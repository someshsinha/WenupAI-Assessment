# Application Settings
APP_NAME=Document Intake Assistant
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# LLM Provider Configuration
# Options: "mock" (default, runs offline) | "gemini"
LLM_PROVIDER=mock

# Gemini Configuration (Only needed if LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
